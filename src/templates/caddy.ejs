www.<%- domain %> {
    redir https://<%- domain %>{uri} permanent
}

<%- domain %> {

    encode gzip

    log {
        output file /var/log/caddy/<%- domain %>.access.log
    }

    <% if (storeType === 'social-media-store') { %>
        reverse_proxy 127.0.0.1:4340
    <% } else { %>
        root * /var/www/<%- storeType %>
        file_server
    <% } %>
}

api.<%- domain %> {

    encode gzip

    log {
        output file /var/log/caddy/<%- domain %>.api.log
    }

    reverse_proxy 127.0.0.1:<%- primaryPort %>
}
