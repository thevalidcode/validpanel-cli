<%- domain %>, www.<%- domain %> {

    # Frontend: proxy for social-media-store, static for others
    <% if (storeType === 'social-media-store') { %>
    reverse_proxy 127.0.0.1:4340
    <% } else { %>
    root * /var/www/<%- storeType %>
    file_server
    <% } %>

    # WebSocket proxy
    handle_path /<%- storeType %>/ws/* {
        reverse_proxy 127.0.0.1:<%- secondaryPort %>
    }

    # Backend proxy
    handle_path /<%- storeType %>/backend/* {
        reverse_proxy 127.0.0.1:<%- primaryPort %> {
            transport http {
                tls
                tls_server_name validpanel.com
            }
        }
    }
}
