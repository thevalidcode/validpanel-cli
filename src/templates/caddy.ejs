<%- domain %>, www.<%- domain %> {

    # Frontend: proxy for social-media-store, static for others
    <% if (storeType === 'social-media-store') { %>
    reverse_proxy localhost:4340

    encode gzip
    log {
      output file /var/log/caddy/social-media-store.log
    }

    <% } else { %>
    root * /var/www/<%- storeType %>
    file_server
    <% } %>

    # Backend proxy
    handle_path /<%- storeType %>/backend/* {
        reverse_proxy 127.0.0.1:<%- primaryPort %>
    }
}
