<%- domain %>, www.<%- domain %> {
    root * /var/www/<%- storeType %>
    file_server

    # WebSocket reverse proxy (secondary port)
    handle_path /<%- storeType %>/ws/* {
        reverse_proxy 127.0.0.1:<%- secondaryPort %>
    }

    # Backend reverse proxy (primary port)
    handle_path /<%- storeType %>/backend/* {
        reverse_proxy 127.0.0.1:<%- primaryPort %> {
            transport http {
                tls
                tls_server_name validpanel.com
            }
        }
    }
}