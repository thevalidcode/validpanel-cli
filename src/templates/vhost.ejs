<VirtualHost *:80>
    ServerName <%= domain %>
    ServerAlias www.<%= domain %>
    DocumentRoot /var/www/<%= domain %>/public

    ProxyPreserveHost On
    ProxyPass / <%= proxyPass %>/
    ProxyPassReverse / <%= proxyPass %>/

    ErrorLog ${APACHE_LOG_DIR}/<%= domain %>-error.log
    CustomLog ${APACHE_LOG_DIR}/<%= domain %>-access.log combined
</VirtualHost>
